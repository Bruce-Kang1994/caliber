# Caliber - Environment Variables
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ============================================================
# Supabase (https://supabase.com/dashboard → Settings → API)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# DeepSeek (https://platform.deepseek.com/api_keys)
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================================
# Stripe Payment (https://dashboard.stripe.com/apikeys)
# ============================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_SINGLE=price_your-single-report-price-id
STRIPE_PRICE_PRO=price_your-pro-subscription-price-id

# ============================================================
# App Settings
# ============================================================
# Set to "true" for local development without API credits
# MUST be "false" in production
USE_MOCK=true
