# Caliber - Environment Variables
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ============================================================
# Supabase (https://supabase.com/dashboard → Settings → API)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# DeepSeek (https://platform.deepseek.com/api_keys)
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================================
# LemonSqueezy Payment (https://app.lemonsqueezy.com/settings/api)
# ============================================================
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_VARIANT_SINGLE=your-single-report-variant-id
LEMONSQUEEZY_VARIANT_PRO=your-pro-subscription-variant-id

# ============================================================
# App Settings
# ============================================================
# Set to "true" for local development without API credits
# MUST be "false" in production
USE_MOCK=true
